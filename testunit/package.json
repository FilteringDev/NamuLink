{
  "name": "@filteringdev/namulink-testunit",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "tsc --noEmit && eslint **/*.ts",
    "test": "ava"
  },
  "ava": {
    "files": [
      "tests/**/*.test.ts"
    ],
    "nodeArguments": [
      "--import=tsx"
    ],
    "workerThreads": false,
    "typescript": {
      "rewritePaths": {
        "@userscript/": "./sources/"
      },
      "compile": false
    }
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@types/node": "^24.13.1",
    "@types/web": "^0.0.345",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@violentmonkey/types": "^0.3.3",
    "ava": "^8.0.1",
    "eslint": "^10.4.0",
    "fast-check": "^4.9.0",
    "tsx": "^4.22.4",
    "typescript-eslint": "^8.59.4"
  }
}
